
function OptOut = BrakingSpeedCalc(OptInputs, GGVSurfAy, trackCurvature, previousVel, sectorDistance, nextLSP)

    % Control Inputs
    
    Vx = OptInputs(1); % Velocity Iteration for current  point
    Ax = OptInputs(1); % Acceleration (deceleration) capability at current point
    Ay = abs((currentVel^2) * trackCurvature); % Check to ensure that cornering capacity is sufficient for curvature
    
    AyGGV = griddata(GGVSurfAy.Vel, GGVSurfAy.Ax, GGVSurfAy.Ay,Vx,Ax,'cubic');

    if isnan(AyGGV)
        AyGGV = 0;
    end
    
    nextVel = abs(sqrt(previousVel^2 - 2*(Ax)*sectorDistance));

    if NextVel > nextLSP
        NextVel = nextLSP; % nextLSP refers to LSP at the 
    end

    OptOut = -NextVel;

end