function [inputMUY,inputMUX] = FrictionEllipseModel(FZ,inputMUY,inputMUX)

    maxMUY = Tyre.refMUY + Tyre.muLoadSensitivity*(FZ - Tyre.refFZ);
    maxMUX = Tyre.refMUX + Tyre.muLoadSensitivity*(FZ - Tyre.refFZ);
    
    % Equation of Ellipse - muy^2 / maxMUY^2 + mux^2 / maxMUX^2 = 1;
    MUXellipse  = @(muy) abs(sqrt((maxMUX^2) * (1 - muy^2 / maxMUY^2))); 
    MUYellipse  = @(mux) abs(sqrt((maxMUY^2) * (1 - mux^2 / maxMUX^2)));

    inputMUX = MUXellipse(inputMUY);
    inputMUY = MUYellipse(inputMUX);
end














